---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { routes } from '../data/routes';

const title = 'Svi penjački smjerovi u Bosni i Hercegovini | balkanbeta';
const description = 'Pretraži i filtriraj penjačke smjerove prema penjalištu, ocjeni, dužini i broju boltova.';
const locations = [...new Set(routes.map((route) => route.location))].sort((a, b) => a.localeCompare(b, 'bs'));
---

<BaseLayout {title} {description}>
  <Header />
  <main class="routes-directory">
    <div class="routes-directory-inner">
      <header class="routes-directory-intro">
        <h1>Svi smjerovi</h1>
        <p>Pronađi smjer prema lokaciji, ocjeni ili opremi.</p>
      </header>

      <form class="route-filters" data-route-filters role="search" aria-label="Filtriranje penjačkih smjerova">
        <div class="directory-search">
          <label class="sr-only" for="routes-query">Pretraži naziv smjera ili penjalište</label>
          <svg viewBox="0 0 24 24" width="23" height="23" aria-hidden="true">
            <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="1.8"></circle>
            <path d="m16.2 16.2 4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
          </svg>
          <input id="routes-query" name="q" type="search" placeholder="Pretraži naziv smjera ili penjalište" autocomplete="off" />
        </div>

        <label class="filter-field">
          <span>Penjalište</span>
          <select name="location">
            <option value="">Sva penjališta</option>
            {locations.map((location) => <option value={location.toLocaleLowerCase('bs')}>{location}</option>)}
          </select>
        </label>

        <label class="filter-field">
          <span>Ocjena</span>
          <select name="grade">
            <option value="">Sve ocjene</option>
            <option value="6">6a – 6c+</option>
            <option value="7">7a i teže</option>
          </select>
        </label>

        <label class="filter-field">
          <span>Dužina</span>
          <select name="length">
            <option value="">Sve dužine</option>
            <option value="short">Do 20 m</option>
            <option value="medium">21 – 25 m</option>
            <option value="long">26 m i više</option>
          </select>
        </label>

        <label class="filter-field">
          <span>Oprema</span>
          <select name="equipment">
            <option value="">Sva oprema</option>
            <option value="do-9">Do 9 boltova</option>
            <option value="10-12">10 – 12 boltova</option>
            <option value="13-plus">13+ boltova</option>
          </select>
        </label>

        <button class="filters-reset" type="reset">
          <svg viewBox="0 0 24 24" width="19" height="19" aria-hidden="true">
            <path d="M5 8V4m0 0h4M5 4l3.1 3.1A7 7 0 1 1 6 15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          Poništi filtere
        </button>
      </form>

      <p class="directory-count" data-route-count aria-live="polite">8 smjerova</p>

      <div class="route-table directory-table" role="table" aria-label="Svi penjački smjerovi">
        <div class="route-row route-head" role="row">
          <span role="columnheader">Topo</span>
          <span role="columnheader">Smjer</span>
          <span role="columnheader">Penjalište</span>
          <span role="columnheader">Ocjena</span>
          <span role="columnheader">Dužina</span>
          <span role="columnheader">Oprema</span>
          <span role="columnheader" class="sr-only">Detalji</span>
        </div>

        {routes.map((route) => (
          <a
            id={route.slug}
            class="route-row route-item directory-route"
            href={`#${route.slug}`}
            role="row"
            data-name={route.name.toLocaleLowerCase('bs')}
            data-location={route.location.toLocaleLowerCase('bs')}
            data-grade={route.gradeBand}
            data-length={route.length <= 20 ? 'short' : route.length <= 25 ? 'medium' : 'long'}
            data-equipment={route.equipmentBand}
          >
            <span role="cell" class="route-topo" aria-hidden="true">
              <img src={route.image.src} alt="" width="110" height="72" loading="lazy" decoding="async" />
            </span>
            <strong role="cell" data-label="Smjer">{route.name}</strong>
            <span role="cell" data-label="Penjalište">{route.location}</span>
            <strong role="cell" data-label="Ocjena" class="route-grade">{route.grade}</strong>
            <span role="cell" data-label="Dužina">{route.length} m</span>
            <span role="cell" data-label="Oprema">{route.bolts} boltova</span>
            <span role="cell" class="row-arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="22" height="22">
                <path d="M5 12h13M14 7l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </span>
          </a>
        ))}
      </div>

      <div class="directory-empty" data-directory-empty hidden>
        <strong>Nema smjerova za odabrane filtere.</strong>
        <p>Pokušaj promijeniti pretragu ili poništi filtere.</p>
      </div>
    </div>
  </main>
  <SiteFooter />

  <script>
    const form = document.querySelector<HTMLFormElement>('[data-route-filters]');
    const queryInput = form?.elements.namedItem('q') as HTMLInputElement | null;
    const locationInput = form?.elements.namedItem('location') as HTMLSelectElement | null;
    const gradeInput = form?.elements.namedItem('grade') as HTMLSelectElement | null;
    const lengthInput = form?.elements.namedItem('length') as HTMLSelectElement | null;
    const equipmentInput = form?.elements.namedItem('equipment') as HTMLSelectElement | null;
    const rows = [...document.querySelectorAll<HTMLElement>('.directory-route')];
    const countLabel = document.querySelector<HTMLElement>('[data-route-count]');
    const emptyState = document.querySelector<HTMLElement>('[data-directory-empty]');

    function countText(count: number) {
      if (count === 1) return '1 smjer';
      if (count > 1 && count < 5) return `${count} smjera`;
      return `${count} smjerova`;
    }

    function applyFilters() {
      const query = queryInput?.value.trim().toLocaleLowerCase('bs') ?? '';
      const location = locationInput?.value ?? '';
      const grade = gradeInput?.value ?? '';
      const length = lengthInput?.value ?? '';
      const equipment = equipmentInput?.value ?? '';
      let visibleCount = 0;

      rows.forEach((row) => {
        const matchesQuery = !query || row.dataset.name?.includes(query) || row.dataset.location?.includes(query);
        const isVisible = matchesQuery
          && (!location || row.dataset.location === location)
          && (!grade || row.dataset.grade === grade)
          && (!length || row.dataset.length === length)
          && (!equipment || row.dataset.equipment === equipment);

        row.hidden = !isVisible;
        if (isVisible) visibleCount += 1;
      });

      if (countLabel) countLabel.textContent = countText(visibleCount);
      if (emptyState) emptyState.hidden = visibleCount !== 0;
    }

    function useQueryString() {
      const query = new URLSearchParams(window.location.search).get('q');
      if (queryInput && query) queryInput.value = query;
      applyFilters();
    }

    form?.addEventListener('input', applyFilters);
    form?.addEventListener('change', applyFilters);
    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      applyFilters();
    });
    form?.addEventListener('reset', () => window.setTimeout(applyFilters));
    useQueryString();
  </script>
</BaseLayout>
