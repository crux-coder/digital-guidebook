---
import { recentlyAddedRoutes } from '../data/routes';
---

<section class="routes-section" id="rute" aria-labelledby="routes-heading">
  <div class="section-heading-row">
    <h2 id="routes-heading">Nedavno dodano</h2>
    <a href="/rute">Pogledaj sve rute <span aria-hidden="true">→</span></a>
  </div>

  <div class="route-table" role="table" aria-label="Nedavno dodani penjački smjerovi">
    <div class="route-row route-head" role="row">
      <span role="columnheader">Topo</span>
      <span role="columnheader">Ruta</span>
      <span role="columnheader">Penjalište</span>
      <span role="columnheader">Ocjena</span>
      <span role="columnheader">Dužina</span>
      <span role="columnheader">Oprema</span>
      <span role="columnheader" class="sr-only">Detalji</span>
    </div>

    {recentlyAddedRoutes.map((route) => (
      <a
        class="route-row route-item"
        href={`/rute#${route.slug}`}
        role="row"
      >
        <span role="cell" class="route-topo" aria-hidden="true">
          <img src={route.image.src} alt="" width="110" height="72" loading="lazy" decoding="async" />
        </span>
        <strong role="cell" data-label="Ruta">{route.name}</strong>
        <span role="cell" data-label="Penjalište">{route.location}</span>
        <strong role="cell" data-label="Ocjena" class="route-grade">{route.grade}</strong>
        <span role="cell" data-label="Dužina">{route.length} m</span>
        <span role="cell" data-label="Oprema">{route.bolts} boltova</span>
        <span role="cell" class="row-arrow" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="22" height="22">
            <path d="M5 12h13M14 7l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </span>
      </a>
    ))}
  </div>
</section>
